# Every setting the stack reads. Copy to .env and fill in. Never commit .env.
# Users bring their own Anthropic API key (D-002); the server only stores it encrypted.
# 32-byte key, base64, for encrypting user API keys at rest. Rotate by re-encrypting.
USER_KEY_ENCRYPTION_KEY=
# Default monthly token cap per user key (input + output); each user can change theirs.
DEFAULT_MONTHLY_TOKEN_CAP=2000000
